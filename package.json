{
  "name": "@rescript/webapi",
  "version": "1.0.0-alpha.1",
  "description": "Experimental successor to [rescript-webapi](https://github.com/TheSpyder/rescript-webapi)",
  "keywords": [
    "dom",
    "fetch",
    "mdn",
    "rescript",
    "webapi"
  ],
  "homepage": "https://rescript-lang.github.io/experimental-rescript-webapi/",
  "bugs": "https://github.com/rescript-lang/experimental-rescript-webapi/issues",
  "license": "MIT",
  "author": {
    "name": "ReScript"
  },
  "maintainers": [
    "Bernardo Gurgel (https://github.com/brnrdog)",
    "Josh Vlk (https://github.com/jderochervlk)",
    "Paul Tsnobiladzé (https://github.com/tsnobip)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rescript-lang/experimental-rescript-webapi.git"
  },
  "files": [
    "rescript.json",
    "src/**/*.res",
    "src/**/*.resi",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "rescript clean && node tests/index.js",
    "test:browser": "rescript clean && npm run build && playwright test",
    "test:negative": "node scripts/check-consumer.mjs --negative-only",
    "build": "rescript",
    "check:features": "node --test scripts/check-features.test.mjs && node scripts/check-features.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:release": "node --test scripts/validate-release-artifact.test.mjs && node scripts/check-release.mjs",
    "format": "rescript format && oxfmt ./tests/index.js ./tests/fixtures.json ./tests/browser/native-api.spec.mjs ./tests/browser/describe-error.mjs ./tests/browser/server.mjs ./scripts/negative-fixtures.json ./scripts/validate-release-artifact.mjs ./scripts/validate-release-artifact.test.mjs ./playwright.config.mjs ./scripts/check-consumer.mjs ./scripts/check-release.mjs ./scripts/check-features.mjs ./scripts/check-features.test.mjs ./package.json ./docs && prettier --write .github/workflows/*.yml ./docs/pages",
    "format:check": "rescript format --check && oxfmt ./tests/index.js ./tests/fixtures.json ./tests/browser/native-api.spec.mjs ./tests/browser/describe-error.mjs ./tests/browser/server.mjs ./scripts/negative-fixtures.json ./scripts/validate-release-artifact.mjs ./scripts/validate-release-artifact.test.mjs ./playwright.config.mjs ./scripts/check-consumer.mjs ./scripts/check-release.mjs ./scripts/check-features.mjs ./scripts/check-features.test.mjs ./package.json ./docs --check && prettier --check .github/workflows/*.yml ./docs/pages",
    "docs": "astro dev",
    "prebuild:docs": "node docs/llm.js",
    "build:docs": "astro build"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.42.8",
    "@playwright/test": "^1.64.1",
    "astro": "^7.2.9",
    "micromark": "^4.0.1",
    "oxfmt": "^0.75.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^1.0.0",
    "rescript": "13.0.0-alpha.5",
    "sharp": "^0.35.3"
  },
  "peerDependencies": {
    "rescript": ">=13.0.0-alpha.5 <13.0.0"
  },
  "overrides": {
    "mdast-util-to-hast": "^13.2.1",
    "postcss-selector-parser": "^6.1.5"
  }
}
